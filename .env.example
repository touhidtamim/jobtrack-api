NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/trackerDB?retryWrites=true&w=majority

JWT_SECRET=your_super_secret_jwt_key_at_least_16_characters_long
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

CORS_ORIGIN=*

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=50

SEED_ADMIN_EMAIL=admin@jobtrack.test
SEED_ADMIN_PASSWORD=
SEED_DEMO_EMAIL=demo@jobtrack.test
SEED_DEMO_PASSWORD=
